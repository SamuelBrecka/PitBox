# PostgreSQL Database Configuration
POSTGRES_DB=pitbox
POSTGRES_USER=pitbox
POSTGRES_PASSWORD=pitbox_secure_password_change_me
POSTGRES_PORT=5432

# Backend Security / JWT Configuration (Min 256-bit secret key)
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_base64_or_hex_string
JWT_EXPIRATION_MS=86400000

# Application Ports & Storage
BACKEND_PORT=8080
FRONTEND_PORT=80
UPLOAD_DIR=/app/uploads
